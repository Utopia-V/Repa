{
  "name": "repa",
  "license": "Apache-2.0",
  "private": true,
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "workspaces": [
    "packages/space-history",
    "packages/base",
    "packages/learning-model",
    "packages/python-runner",
    "packages/learning",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build:packages && npm run build:app --workspaces --if-present",
    "build:backend": "npm run build --workspace=@repa/base",
    "check": "npm run check --workspaces --if-present --ignore-scripts",
    "dev:backend": "npm --workspace=@repa/base run start -- serve",
    "dev:desktop": "npm run dev --workspace=@repa/desktop",
    "dev:web": "npm run dev --workspace=@repa/web",
    "dev:web:learning": "npm run dev:learning --workspace=@repa/web",
    "precheck": "npm run build:packages",
    "pretest": "npm run build:packages",
    "start": "npm --workspace=@repa/base run start -- serve",
    "test": "npm run docs:check && npm run test:docs-scripts && npm run test --workspaces --if-present --ignore-scripts",
    "course:check": "npm run course:check --workspace=@repa/learning --",
    "course:runtime": "npm run course:runtime --workspace=@repa/learning --",
    "course:confirm": "npm run course:confirm --workspace=@repa/learning --",
    "predev:learning": "npm run build:packages",
    "dev:learning": "npm --workspace=@repa/base run start -- serve --plugin ../learning --no-general-agent --direct-agent learning-tutor",
    "build:packages": "tsc -b tsconfig.build.json && npm run build:assets --workspaces --if-present",
    "docs:check": "tsx --tsconfig scripts/docs/tsconfig.json scripts/docs/check.ts",
    "test:docs-scripts": "tsx --tsconfig scripts/docs/tsconfig.json --test scripts/docs/*.test.ts",
    "docs:gen": "tsx --tsconfig scripts/docs/tsconfig.json scripts/docs/gen-packages.ts && tsx --tsconfig scripts/docs/tsconfig.json scripts/docs/gen-protocol.ts && tsx --tsconfig scripts/docs/tsconfig.json scripts/docs/gen-tools.ts && tsx --tsconfig scripts/docs/tsconfig.json scripts/docs/gen-host-api.ts && tsx --tsconfig scripts/docs/tsconfig.json scripts/docs/gen-persistence.ts"
  },
  "devDependencies": {
    "github-slugger": "^2.0.0",
    "mdast-util-from-markdown": "^2.0.2",
    "mdast-util-gfm": "^3.0.0",
    "micromark-extension-gfm": "^3.0.0"
  }
}
