{
  "name": "repa",
  "license": "Apache-2.0",
  "private": true,
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "workspaces": [
    "packages/learning-model"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "check": "npm run check --workspaces --if-present",
    "test": "npm run lint && npm run docs:check && npm run test:docs-scripts && npm run test --workspaces --if-present",
    "lint": "eslint .",
    "docs:check": "tsx --tsconfig scripts/docs/tsconfig.json scripts/docs/check.ts",
    "test:docs-scripts": "tsx --tsconfig scripts/docs/tsconfig.json --test scripts/docs/*.test.ts"
  },
  "devDependencies": {
    "eslint": "^10.14.0",
    "github-slugger": "^2.0.0",
    "mdast-util-from-markdown": "^2.0.2",
    "mdast-util-gfm": "^3.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "typescript-eslint": "^8.72.1"
  }
}
