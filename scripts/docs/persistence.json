{
  "stage": "test",
  "$comment": "首个测试版起为 test：schema 摘要变化须先在 docs/persistence/changes/ 记下版本判断及理由，见 docs/AGENTS.md。",
  "formats": [
    {
      "id": "space-format",
      "files": ["<空间>/.repa/format.json"],
      "owner": "@repa/base",
      "schema": "packages/base/src/space/format.ts#FormatSchema",
      "versionedBy": "<空间>/.repa/format.json"
    },
    {
      "id": "session-parent",
      "files": ["<空间>/.repa/sessions/<会话 id>.parent.json"],
      "owner": "@repa/base",
      "schema": "packages/base/src/schema.ts#SessionParentSchema",
      "versionedBy": "<空间>/.repa/format.json"
    },
    {
      "id": "history-source",
      "files": ["<空间>/.repa/history.git（Git 提交消息）"],
      "owner": "@repa/space-history",
      "schema": "packages/space-history/src/schema.ts#SourceSchema",
      "versionedBy": "<空间>/.repa/format.json"
    },
    {
      "id": "app-settings",
      "files": ["<应用配置目录>/settings.json"],
      "owner": "@repa/base",
      "schema": "packages/base/src/schema.ts#SettingsSchema",
      "versionedBy": "无独立版本标记"
    },
    {
      "id": "restore-marker",
      "files": ["<空间>/.repa/restore.json"],
      "owner": "@repa/base",
      "schema": "packages/base/src/schema.ts#RestoreMarkerSchema",
      "versionedBy": "<空间>/.repa/format.json"
    },
    {
      "id": "backup-manifest",
      "files": ["<应用配置目录>/backups/<空间分组>/<备份 id>/manifest.json"],
      "owner": "@repa/base",
      "schema": "packages/base/src/schema.ts#BackupManifestSchema",
      "versionedBy": "无独立版本标记；备份中的 data/ 是 .repa/ 的副本，由其中的 format.json 标记"
    },
    {
      "id": "learning-format",
      "files": ["<空间>/.repa/plugins/learning/format.json"],
      "owner": "@repa/learning",
      "schema": "packages/base/src/space/format.ts#FormatSchema",
      "versionedBy": "<空间>/.repa/plugins/learning/format.json"
    },
    {
      "id": "learning-records",
      "files": ["<空间>/.repa/plugins/learning/records.jsonl"],
      "owner": "@repa/learning",
      "schema": "packages/learning/src/records-schema.ts#FactSchema",
      "versionedBy": "<空间>/.repa/plugins/learning/format.json"
    },
    {
      "id": "plugin-manifest",
      "files": ["<空间>/.agents/plugins/<插件 id>/repa-plugin.json", "随包插件文件夹的 repa-plugin.json"],
      "owner": "@repa/base",
      "schema": "packages/base/src/plugins/manifest.ts#PluginManifestSchema",
      "versionedBy": "无独立版本标记；可选的 baseVersion 声明插件兼容的底座版本范围，自写插件可以不写"
    },
    {
      "id": "plugin-snapshot",
      "files": ["<应用配置目录>/plugins/<空间分组>/<插件 id>/<摘要>/"],
      "owner": "@repa/base",
      "schema": "packages/base/src/plugins/manifest.ts#PluginManifestSchema",
      "versionedBy": "目录名是插件文件夹的摘要，摘要输入的第一行 repa-plugin-folder 1 是算法版本；快照的内容是一份插件文件夹，其中的清单即 plugin-manifest"
    },
    {
      "id": "plugin-enablement",
      "files": ["<空间>/.repa/plugins.json"],
      "owner": "@repa/base",
      "schema": "packages/base/src/plugins/enablement.ts#PluginEnablementSchema",
      "versionedBy": "<空间>/.repa/format.json"
    },
    {
      "id": "learning-course-choice",
      "files": ["<空间>/.repa/plugins/learning/course.json"],
      "owner": "@repa/learning",
      "schema": "packages/learning/src/space-course.ts#CourseChoiceSchema",
      "versionedBy": "<空间>/.repa/plugins/learning/format.json"
    },
    {
      "id": "learning-building",
      "files": ["<空间>/.repa/plugins/learning/building.json"],
      "owner": "@repa/learning",
      "schema": "packages/learning/src/course-building.ts#BuildingRecordSchema",
      "versionedBy": "<空间>/.repa/plugins/learning/format.json"
    },
    {
      "id": "learning-settings",
      "files": ["<空间>/.repa/plugins/learning/settings.json"],
      "owner": "@repa/learning",
      "schema": "packages/learning/src/protocol.ts#LearningSettingsSchema",
      "versionedBy": "<空间>/.repa/plugins/learning/format.json"
    },
    {
      "id": "learning-course",
      "files": ["<空间>/course/course.yaml", "<空间>/.repa/plugins/learning/courses/<摘要>/course.yaml", "随包课程的 course.yaml"],
      "owner": "@repa/learning",
      "schema": "packages/learning/src/format/schema.ts#CourseSchema",
      "versionedBy": "无独立版本标记；换用过的副本目录名是内容摘要，课程自己的 version 只记进学习记录"
    },
    {
      "id": "learning-topic",
      "files": ["<空间>/course/topics/<topic id>.yaml", "<空间>/.repa/plugins/learning/courses/<摘要>/topics/<topic id>.yaml", "随包课程的 topics/<topic id>.yaml"],
      "owner": "@repa/learning",
      "schema": "packages/learning/src/format/schema.ts#TopicSchema",
      "versionedBy": "无独立版本标记；与 learning-course 同在一份课程里"
    }
  ]
}
