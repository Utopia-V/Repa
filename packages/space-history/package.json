{
  "name": "@repa/space-history",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "benchmark": "node --import tsx test/benchmark.ts",
    "benchmark:maintenance": "node --import tsx test/maintenance-benchmark.ts",
    "benchmark:paths": "node --import tsx test/record-paths-benchmark.ts",
    "precheck": "npm run build",
    "pretest": "npm run build"
  },
  "dependencies": {
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/node": "22.19.21",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  }
}
