{
  "name": "@repa/materials",
  "version": "0.1.0",
  "description": "Repa 本地材料读取与提取能力",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "repa": {
    "manifestVersion": 1,
    "backend": {
      "entry": "./dist/index.js",
      "api": "^1.1.0"
    }
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "node --import tsx --test test/*.test.ts",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "repa": "^0.1.0"
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0",
    "image-size": "2.0.4",
    "jsdom": "30.0.1",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/jsdom": "30.0.0",
    "@types/node": "22.19.21",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  }
}
