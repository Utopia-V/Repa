{
  "name": "@repa/python-runner",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "runner.py",
    "sandbox"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.js"
    },
    "./worker": {
      "types": "./dist/browser/worker.d.ts",
      "import": "./dist/browser/worker.js"
    },
    "./runner.py": "./runner.py"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "build": "tsc -b tsconfig.browser.build.json",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.browser.json",
    "precheck": "npm run build",
    "pretest": "npm run build",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@repa/base": "0.1.0",
    "pyodide": "314.0.7",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/node": "22.19.21",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  }
}
