{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2023", "DOM"], "module": "NodeNext", "moduleResolution": "NodeNext",
    "types": ["node"], "strict": true, "noUncheckedIndexedAccess": true, "noUnusedLocals": true,
    "noUnusedParameters": true, "verbatimModuleSyntax": true, "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true, "esModuleInterop": true
  },
  "include": ["test/**/*.ts"]
}
