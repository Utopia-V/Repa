{
  "name": "@repa/base",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "examples"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    }
  },
  "bin": {
    "repa-base": "dist/cli.js"
  },
  "scripts": {
    "prebuild": "npm run build --workspace=@repa/space-history",
    "build": "tsc -p tsconfig.build.json",
    "precheck": "npm run build",
    "check": "tsc --noEmit",
    "pretest": "npm run build --workspace=@repa/space-history",
    "test": "node --import tsx --test test/*.test.ts",
    "start": "tsx src/cli.ts",
    "prereal-model-check": "npm run build",
    "real-model-check": "tsx scripts/real-model-check.ts"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "dependencies": {
    "@repa/space-history": "0.1.0",
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "proper-lockfile": "4.1.2",
    "typebox": "1.3.27",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/node": "22.19.21",
    "@types/proper-lockfile": "4.1.4",
    "@types/ws": "8.18.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  }
}
