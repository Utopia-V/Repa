{
  "name": "@repa/base",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "examples"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    },
    "./process": {
      "types": "./dist/process.d.ts",
      "import": "./dist/process.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "bin": {
    "repa-base": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -b tsconfig.examples.json && npm run build:assets",
    "precheck": "npm run build",
    "check": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "node --import tsx --test --test-timeout=600000 test/*.test.ts",
    "start": "tsx src/cli.ts",
    "prereal-model-check": "npm run build",
    "real-model-check": "tsx scripts/real-model-check.ts",
    "build:assets": "node -e \"require('node:fs').copyFileSync('examples/repa-plugin.json', 'dist/examples/repa-plugin.json')\"",
    "prestart": "npm run build"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "dependencies": {
    "@repa/space-history": "0.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "proper-lockfile": "4.1.2",
    "semver": "7.7.3",
    "typebox": "1.3.27",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/node": "22.19.21",
    "@types/proper-lockfile": "4.1.4",
    "@types/semver": "7.7.1",
    "@types/ws": "8.18.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  }
}
