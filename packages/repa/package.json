{
  "name": "repa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "resources/sandbox/linux-x64",
    "resources/sandbox/source.json",
    "resources/sandbox/Cargo.lock",
    "resources/sandbox/parent-lifecycle.patch",
    "resources/sandbox/licenses",
    "scripts/build-sandbox.mjs",
    "scripts/sandbox-profile.mjs"
  ],
  "bin": {
    "repa": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:sandbox": "node scripts/build-sandbox.mjs",
    "build:release": "npm run build && npm run build:sandbox",
    "sandbox:profile": "node scripts/sandbox-profile.mjs",
    "check": "tsc --noEmit",
    "start": "tsx src/cli.ts",
    "test": "node --import tsx --import ./test/environment.ts --test test/*.test.ts"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.3.0",
    "@modelcontextprotocol/core": "2.3.0",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "mdast-util-from-markdown": "2.0.3",
    "micromark": "4.0.2",
    "proper-lockfile": "4.1.2",
    "semver": "7.8.5",
    "typebox": "1.3.27",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/node": "22.19.21",
    "@types/proper-lockfile": "4.1.4",
    "@types/semver": "7.8.0",
    "@types/ws": "8.18.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "@repa/learning": "0.1.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    },
    "./display": {
      "types": "./dist/display.d.ts",
      "import": "./dist/display.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    },
    "./cli": {
      "types": "./dist/cli-main.d.ts",
      "import": "./dist/cli-main.js"
    }
  }
}
