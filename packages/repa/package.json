{
  "name": "@repa/repa",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "description": "Repa 的本机后端与 Pi 扩展",
  "type": "module",
  "bin": {
    "repa": "./bin/repa.mjs"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --import tsx --test --test-timeout=120000 test/*.test.ts",
    "start": "node --import tsx src/main.ts",
    "pretest": "npm run build --workspace=@repa/learning-model --prefix ../..",
    "precheck": "npm run build --workspace=@repa/learning-model --prefix ../.."
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.6.1",
    "@earendil-works/pi-coding-agent": "1.6.1",
    "@repa/learning-model": "0.1.0",
    "diff": "8.0.4",
    "tsx": "4.23.12",
    "typebox": "1.3.27",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "22.19.21",
    "typescript": "5.9.3"
  }
}
