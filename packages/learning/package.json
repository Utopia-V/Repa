{
  "name": "@repa/learning",
  "version": "0.1.0",
  "license": "Apache-2.0 AND CC-BY-NC-SA-4.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "sandbox",
    "courses",
    "repa-plugin.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    },
    "./sandbox/runtime": {
      "types": "./dist/sandbox/runtime.d.ts",
      "import": "./dist/sandbox/runtime.js"
    },
    "./sandbox/runner.py": "./sandbox/runner.py"
  },
  "bin": {
    "repa-course": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "prebuild": "npm run build --workspace=@repa/base && npm run build --workspace=@repa/learning-model",
    "build": "tsc -p tsconfig.build.json && npm run build:protocol",
    "build:protocol": "esbuild src/protocol.ts --bundle --platform=browser --format=esm --outfile=dist/protocol.browser.js",
    "precheck": "npm run build --workspace=@repa/base && npm run build --workspace=@repa/learning-model",
    "check": "tsc --noEmit",
    "pretest": "npm run build --workspace=@repa/base && npm run build --workspace=@repa/learning-model",
    "test": "node --import tsx --test test/*.test.ts",
    "precourse:check": "tsx scripts/ensure-base.ts",
    "course:check": "tsx src/cli.ts check",
    "precourse:runtime": "tsx scripts/ensure-base.ts",
    "course:runtime": "tsx src/cli.ts runtime",
    "precourse:confirm": "tsx scripts/ensure-base.ts",
    "course:confirm": "tsx src/cli.ts confirm"
  },
  "dependencies": {
    "@repa/base": "0.1.0",
    "pyodide": "314.0.7",
    "typebox": "1.3.27",
    "yaml": "2.9.1",
    "@repa/learning-model": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "22.19.21",
    "esbuild": "0.28.2",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  }
}
