{
  "name": "@repa/learning",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "sandbox",
    "courses"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "repa-course": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "course:check": "tsx src/cli.ts check",
    "course:runtime": "tsx src/cli.ts runtime"
  },
  "dependencies": {
    "pyodide": "314.0.7",
    "typebox": "1.3.27",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "22.19.21",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  }
}
