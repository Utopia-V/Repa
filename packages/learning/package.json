{
  "name": "@repa/learning",
  "version": "0.1.0",
  "description": "Repa 官方学习产品、学习语境与教学辅助",
  "type": "module",
  "files": [
    "dist",
    "skills",
    "README.md",
    "CONTEXT.md"
  ],
  "pi": {
    "skills": [
      "./skills"
    ]
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "peerDependencies": {
    "repa": "^0.1.0"
  },
  "bin": {
    "repa-learning": "dist/cli.js"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./product": {
      "types": "./dist/product.d.ts",
      "import": "./dist/product.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    },
    "./cli": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "prepack": "npm run build",
    "start": "tsx src/cli.ts",
    "pretest": "npm run build"
  },
  "dependencies": {
    "@repa/materials": "0.1.0",
    "@repa/planning": "0.1.0",
    "@repa/review": "0.1.0",
    "@repa/organization": "0.1.0",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/node": "22.19.21",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  }
}
