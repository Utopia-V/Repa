+    await page.fill("想学的内容与目标", request);
+    await page.click({ name: "开始", selector: "button" });
+    await page.waitFor("整门课和菜单", (current) => current.includes("整门课") && current.includes("接下来"), 90_000);
+  } else {
+    await page.click({ name: "新会话", selector: "a, button" });
+    await page.fill("消息", request);
+    await page.press("Enter");
+    await page.waitText(done, 90_000);
+  }
+  const used = model.toolResults.slice(seen).find((result) => result.tool === "course_use")?.text ?? "";
+  checks.expect("Agent 做的课换用成功", used.startsWith("已换用"), used.split("\n")[0]);
+  if ((await openDialog(page)) !== "") await page.press("Escape");
+  await until("抽屉关上", async () => (await openDialog(page)) === "");
+}
+
+/**
+ * 记下一个空间此刻的学习记录有几行、最后一条的时间：之后只追加学习记录的，固定数据取这一段前缀就是这一刻盘上的样子。
+ * 之后还会改别的文件（换用课程）的，snapshot 为真，把整个空间复制一份到走查目录的 snapshots/。
+ */
+async function mark(app: App, name: string, label: string, snapshot = false): Promise<void> {
+  if (snapshot) await cp(path.join(app.home, "Repa", name), path.join(app.dir, "snapshots", name, label), { recursive: true });
+  const file = path.join(app.dir, "test1-marks.json");
+  const marks = JSON.parse(await readFile(file, "utf8").catch(() => "[]")) as unknown[];
+  const facts = (await readFile(path.join(app.home, "Repa", name, ".repa", "plugins", "learning", "records.jsonl"), "utf8").catch(() => "")).split("\n").filter(Boolean).map((line) => JSON.parse(line) as { at: number });
+  marks.push({ space: name, label, facts: facts.length, lastAt: facts.at(-1)?.at ?? null, clock: Date.now() + app.clockOffsetMs });
+  await writeFile(file, JSON.stringify(marks, null, 2));
+}
