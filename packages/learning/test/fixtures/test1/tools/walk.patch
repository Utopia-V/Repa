+/**
+ * 测试版固定数据用（只在 v0.1.0-test.1 的工作树里，不进产品）：用这个标签的学习插件算出标准答案。
+ *   npx tsx --tsconfig scripts/verify/tsconfig.json scripts/verify/test1-capture.ts <固定数据目录>
+ *
+ * 读数由 packages/learning/test/fixtures/test1-readings.ts 取（与 dev 上的同一份文件，复制到这里），每个取数点一个子进程，
+ * 时区 Asia/Shanghai，时钟停在取数时刻。每个取数点再起一次这个标签的后端（时钟同样停住，前端能力相同），
+ * 经协议调用同样的四个方法，与进程内的结果逐项比较：一致才写标准答案，说明进程内取数与学习者的应用给出的相同。
+ */
+import { execFile } from "node:child_process";
+import { createHash } from "node:crypto";
+import { mkdir, mkdtemp, readFile, realpath, rm, writeFile } from "node:fs/promises";
+import os from "node:os";
+import path from "node:path";
+import { isDeepStrictEqual, promisify } from "node:util";
+import { fileURLToPath, pathToFileURL } from "node:url";
+
+import { RepaClient } from "@repa/base/client";
+import { startRepaProcess } from "@repa/base/process";
+
+const run = promisify(execFile);
+const REPO = fileURLToPath(new URL("../..", import.meta.url));
+const LEARNING = path.join(REPO, "packages/learning");
+const READINGS = path.join(LEARNING, "test/fixtures/test1-readings.ts");
+const CLOCK = fileURLToPath(new URL("./clock.mjs", import.meta.url));
+const TZ = "Asia/Shanghai";
+const WEB_CAPABILITIES = {
+  interaction: { supports: ["slot.choice", "slot.text", "slot.order", "slot.table", "slot.code", "block.markdown", "block.code", "markdown.math"] },
+  services: ["python.run"],
+};
+
+const [fixture] = process.argv.slice(2);
+if (!fixture) throw new Error("用法：test1-capture.ts <固定数据目录>");
+
+interface Mark { space: string; label: string; facts: number; lastAt: number }
+/** 一个取数点：snapshot 给出时取走查中途整份复制的那个空间，facts 给出时只留学习记录的前这么多行。 */
+interface Case { id: string; space: string; snapshot?: string; facts: number | null; model: boolean; at: number; why: string }
+
+/** 上海时间某一天的某个钟点。 */
+function local(day: number, hour: number, addDays = 0): number {
+  const date = new Intl.DateTimeFormat("en-CA", { timeZone: TZ, year: "numeric", month: "2-digit", day: "2-digit" }).format(day);
+  return Date.parse(`${date}T${String(hour).padStart(2, "0")}:00:00+08:00`) + addDays * 86_400_000;
+}
+const localText = (time: number) => new Intl.DateTimeFormat("sv-SE", { timeZone: TZ, dateStyle: "short", timeStyle: "medium" }).format(time);
+
+const marks = JSON.parse(await readFile(path.join(fixture, "marks.json"), "utf8")) as Mark[];
+const markOf = (space: string, label: string) => {
+  const found = marks.filter((entry) => entry.space === space && entry.label === label).at(-1);
+  if (!found) throw new Error(`没有记下 ${space} 的 ${label}`);
+  return found;
+};
+const full = (space: string) => markOf(space, "full");
+
+const A = "操作系统 走查";
+const B = "操作系统 复习";
+const C = "Python 入门";
+const D = "先学 Python 再学进程";
+const E = "Python 测验";
+const nearQuiz = marks.filter((entry) => entry.space === E && entry.label.startsWith("before-lesson-")).at(-1);
+if (!nearQuiz) throw new Error("没有戊在测验门槛之前的记号");
+const aLast = (await readFile(path.join(fixture, "home/Repa", A, ".repa/plugins/learning/records.jsonl"), "utf8")).split("\n").filter(Boolean).map((line) => JSON.parse(line) as { at: number }).at(-1)?.at ?? 0;
+
+const cases: Case[] = [
+  { id: "a-after", space: A, facts: null, model: true, at: aLast + 60_000, why: "甲：隔天复习做完一分钟后" },
+  { id: "a-evening", space: A, facts: null, model: true, at: local(aLast, 21), why: "甲：复习那天晚上 9 点" },
+  { id: "a-later", space: A, facts: null, model: true, at: local(aLast, 9, 3), why: "甲：三天后上午 9 点，复习到期" },
+  { id: "b-day1-end", space: B, facts: markOf(B, "day1-end").facts, model: false, at: markOf(B, "day1-end").lastAt + 60_000, why: "乙：第一天结束时的日志，开放题没判出，没有可用的模型" },
+  { id: "b-day1-evening", space: B, facts: markOf(B, "day1-end").facts, model: false, at: local(markOf(B, "day1-end").lastAt, 21), why: "乙：同上，第一天晚上 9 点" },
+  { id: "b-after", space: B, facts: null, model: true, at: full(B).lastAt + 60_000, why: "乙：隔天补判为对一分钟后" },
+  { id: "b-later", space: B, facts: null, model: true, at: local(full(B).lastAt, 9, 3), why: "乙：三天后上午 9 点" },
+  { id: "c-after", space: C, facts: null, model: true, at: full(C).lastAt + 60_000, why: "丙：py02 第二次停在同一个知识点一分钟后，强制补救" },
+  { id: "c-evening", space: C, facts: null, model: true, at: local(full(C).lastAt, 21), why: "丙：同一天晚上 9 点" },
+  { id: "c-later", space: C, facts: null, model: true, at: local(full(C).lastAt, 9, 3), why: "丙：三天后上午 9 点" },
+  { id: "d-python-only", space: D, snapshot: "python-only", facts: null, model: true, at: markOf(D, "python-only").lastAt + 60_000, why: "丁：只学过随包的 Python 课、还没做自制课时整份复制的空间" },
+  { id: "d-after", space: D, facts: null, model: true, at: full(D).lastAt + 60_000, why: "丁：换用自制课、学完一节、下一节做到一半一分钟后" },
+  { id: "d-later", space: D, facts: null, model: true, at: local(full(D).lastAt, 9, 3), why: "丁：三天后上午 9 点" },
+  { id: "e-near-quiz", space: E, facts: nearQuiz.facts, model: true, at: nearQuiz.lastAt + 60_000, why: "戊：差一节课到测验门槛" },
+  { id: "e-quiz-due", space: E, facts: markOf(E, "quiz-due").facts, model: true, at: markOf(E, "quiz-due").lastAt + 60_000, why: "戊：刚到测验门槛，测验待开始" },
+  { id: "e-quiz-running", space: E, facts: null, model: true, at: full(E).lastAt + 60_000, why: "戊：测验开始、答了一题，截止之前" },
+  { id: "e-quiz-timeout", space: E, facts: null, model: true, at: local(full(E).lastAt, 21), why: "戊：同一天晚上 9 点，测验已过截止时间" },
+];
+
+/** 复制空间，按需要只留学习记录的前几行。 */
+async function copy(target: string, entry: Case): Promise<string> {
+  const { copySpace } = await import(pathToFileURL(READINGS).href) as typeof import("../../packages/learning/test/fixtures/test1-readings.js");
+  const root = path.join(target, "home", "Repa", entry.space);
+  const source = entry.snapshot === undefined ? path.join(fixture, "home/Repa", entry.space) : path.join(fixture, "snapshots", entry.space, entry.snapshot);
+  await copySpace(source, root, entry.facts ?? undefined);
+  return root;
+}
+
+/** 进程内取数：子进程，时区固定。 */
+async function inProcess(root: string, entry: Case): Promise<{ raw: Record<string, unknown>; meaning: unknown }> {
+  const list = path.join(path.dirname(path.dirname(path.dirname(root))), "cases.json");
+  await writeFile(list, JSON.stringify([{ root, at: entry.at, model: entry.model }]));
+  const { stdout } = await run(process.execPath, ["--import", "tsx", "test/fixtures/test1-read.ts", list], {
+    cwd: LEARNING, env: { ...Object.fromEntries(Object.entries(process.env).filter(([key]) => !key.startsWith("TSX_"))), TZ }, maxBuffer: 64 * 1024 * 1024,
+  });
+  return (JSON.parse(stdout) as { raw: Record<string, unknown>; meaning: unknown }[])[0]!;
+}
+
+/** 经这个标签的后端取同样四个方法，时钟停在取数时刻；没有模型的取数点不写 models.json。 */
+async function viaBackend(dir: string, root: string, entry: Case): Promise<Record<string, unknown>> {
+  const home = path.join(dir, "home");
+  const repaHome = path.join(dir, "repa-home");
+  await mkdir(path.join(repaHome, "agent"), { recursive: true });
+  if (entry.model) {
+    await writeFile(path.join(repaHome, "agent", "models.json"), JSON.stringify({ providers: { "repa-verify": { baseUrl: "http://127.0.0.1:9/v1", api: "openai-completions", apiKey: "capture", models: [{ id: "scripted", name: "取数用" }] } } }));
+  }
+  const backend = await startRepaProcess({
+    home: repaHome,
+    plugins: [path.join(REPO, "packages/learning"), path.join(REPO, "packages/materials")],
+    environment: { PATH: process.env.PATH, HOME: home, REPA_HOME: repaHome, TZ, LANG: "C.UTF-8", NODE_OPTIONS: `--import=${pathToFileURL(CLOCK).href}`, REPA_VERIFY_CLOCK_FIXED_MS: String(entry.at) },
+  });
+  try {
+    const client = await RepaClient.connect(backend.connection, { capabilities: WEB_CAPABILITIES } as never);
+    try {
+      const opened = await client.call("space.open" as never, { root } as never) as { opening: string };
+      const call = (method: string) => client.call("plugin.call" as never, { pluginId: "learning", method, input: {}, opening: opened.opening } as never);
+      const state = await call("state.get");
+      const progress = await call("progress.get");
+      const { cost: _cost, ...building } = await call("building.get") as Record<string, unknown>;
+      const settings = await call("settings.get");
+      return JSON.parse(JSON.stringify({ state, progress, building, settings })) as Record<string, unknown>;
+    } finally {
+      await client.close();
+    }
+  } finally {
+    await backend.close();
+  }
+}
+
+const answers: unknown[] = [];
+for (const entry of cases) {
+  const base = await realpath(await mkdtemp(path.join(os.tmpdir(), "repa-test1-capture-")));
+  try {
+    const first = await copy(path.join(base, "a"), entry);
+    const reading = await inProcess(first, entry);
+    const second = await copy(path.join(base, "b"), entry);
+    const backend = await viaBackend(path.join(base, "b"), second, entry);
+    if (!isDeepStrictEqual(backend, reading.raw)) {
+      await writeFile(path.join(os.tmpdir(), `repa-test1-mismatch-${entry.id}.json`), JSON.stringify({ backend, inProcess: reading.raw }, null, 2));
+      throw new Error(`${entry.id}：后端给出的与进程内取数不同，见 ${os.tmpdir()}/repa-test1-mismatch-${entry.id}.json`);
+    }
+    answers.push({ id: entry.id, why: entry.why, space: entry.space, snapshot: entry.snapshot ?? null, facts: entry.facts, model: entry.model, at: entry.at, atLocal: localText(entry.at), reading: reading.meaning });
+    process.stdout.write(`${entry.id}（${localText(entry.at)}）：后端与进程内一致\n`);
+  } finally {
+    await rm(base, { recursive: true, force: true });
+  }
+}
+
+const { stdout: commit } = await run("git", ["rev-parse", "HEAD"], { cwd: REPO });
+const readings = createHash("sha256").update(await readFile(READINGS)).digest("hex");
+await writeFile(path.join(fixture, "answers.json"), `${JSON.stringify({
+  producedBy: { tag: "v0.1.0-test.1", commit: commit.trim(), readings: `test/fixtures/test1-readings.ts sha256:${readings}` },
+  timeZone: TZ,
+  capabilities: WEB_CAPABILITIES,
+  cases: answers,
+}, null, 1)}\n`);
+process.stdout.write(`标准答案：${path.join(fixture, "answers.json")}，${answers.length} 个取数点\n`);
diff --git a/scripts/verify/test1-freeze.mjs b/scripts/verify/test1-freeze.mjs
new file mode 100644
index 000000000..4b0b03e86
--- /dev/null
+++ b/scripts/verify/test1-freeze.mjs
@@ -0,0 +1,77 @@
+/**
+ * 测试版固定数据用（只在 v0.1.0-test.1 的工作树里，不进产品）：把一次走查留下的学习空间冻结成固定数据。
+ *   node scripts/verify/test1-freeze.mjs <走查目录> <输出目录>
+ *
+ * 输出目录里已有的 home/、repa-home/、marks.json 和 answers.json 先删掉，其余（README、tools/）不动。
+ * 输出目录与试用者的布局相同：home/Repa/<课名>/ 是各个空间，repa-home/settings.json 是应用配置里最近打开的空间。
+ * 空目录不留（Git 不保存空目录，固定数据以提交进仓库的样子为准）。文本文件里本机的绝对路径换成占位：
+ * 走查的临时 HOME 换成 /home/learner，仓库根目录换成 /opt/repa。最后扫一遍（含解压后的 history.git 对象），
+ * 还有本机路径、用户名或走查的 key 就报错。snapshots/<课名>/<记号>/ 是走查中途整份复制的空间。marks.json 是走查记下的各空间学习记录行数（前缀）与时刻。
+ */
+import { cp, mkdir, readdir, readFile, rm, rmdir, stat, writeFile } from "node:fs/promises";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+import { inflateSync } from "node:zlib";
+
+const [run, out] = process.argv.slice(2);
+if (!run || !out) throw new Error("用法：test1-freeze.mjs <走查目录> <输出目录>");
+const REPO = fileURLToPath(new URL("../..", import.meta.url)).replace(/\/$/u, "");
+const HOME = path.join(path.resolve(run), "home");
+const REPA_HOME = path.join(path.resolve(run), "repa-home");
+const REPLACE = [[REPA_HOME, "/home/learner/.config/repa"], [HOME, "/home/learner"], [REPO, "/opt/repa"]];
+const FORBIDDEN = [path.resolve(run), REPO, "/home/uranox", "uranox"];
+
+async function* files(directory) {
+  for (const entry of await readdir(directory, { withFileTypes: true })) {
+    const full = path.join(directory, entry.name);
+    if (entry.isDirectory()) yield* files(full);
+    else yield full;
+  }
+}
+
+async function removeEmpty(directory) {
+  for (const entry of await readdir(directory, { withFileTypes: true })) {
+    if (entry.isDirectory()) await removeEmpty(path.join(directory, entry.name));
+  }
+  if ((await readdir(directory)).length === 0) await rmdir(directory);
+}
+
+const inGit = (file) => file.split(path.sep).includes("history.git");
+
+for (const name of ["home", "repa-home", "snapshots", "marks.json", "answers.json"]) await rm(path.join(out, name), { recursive: true, force: true });
+await mkdir(path.join(out, "home"), { recursive: true });
+await cp(path.join(HOME, "Repa"), path.join(out, "home", "Repa"), { recursive: true });
+await mkdir(path.join(out, "repa-home"), { recursive: true });
+await cp(path.join(REPA_HOME, "settings.json"), path.join(out, "repa-home", "settings.json"));
+await cp(path.join(run, "test1-marks.json"), path.join(out, "marks.json"));
+for (const space of await readdir(path.join(out, "home", "Repa"))) await removeEmpty(path.join(out, "home", "Repa", space));
+// 走查中途整份复制下来的空间（之后还改了学习记录以外的文件）。
+await cp(path.join(run, "snapshots"), path.join(out, "snapshots"), { recursive: true });
+await removeEmpty(path.join(out, "snapshots"));
+
+let replaced = 0;
+const data = (file) => ["home", "repa-home", "snapshots", "marks.json"].includes(path.relative(out, file).split(path.sep)[0]);
+for await (const file of files(out)) {
+  if (inGit(file) || !data(file)) continue;
+  const text = await readFile(file, "utf8");
+  let next = text;
+  for (const [from, to] of REPLACE) next = next.split(from).join(to);
+  if (next !== text) {
+    replaced++;
+    await writeFile(file, next);
+  }
+}
+
+const problems = [];
+for await (const file of files(out)) {
+  if (!data(file)) continue;
+  let content = await readFile(file);
+  if (inGit(file) && file.includes(`${path.sep}objects${path.sep}`)) content = inflateSync(content);
+  const text = content.toString("utf8");
+  for (const word of FORBIDDEN) if (text.includes(word)) problems.push(`${path.relative(out, file)} 含 ${word}`);
+  if (/"apiKey"\s*:/u.test(text)) problems.push(`${path.relative(out, file)} 含 apiKey`);
+}
+if (problems.length > 0) throw new Error(`冻结的数据里还有本机信息：\n${problems.join("\n")}`);
+let bytes = 0;
+for await (const file of files(out)) if (data(file)) bytes += (await stat(file)).size;
+process.stdout.write(`已冻结到 ${out}：替换了 ${replaced} 个文件里的本机路径，共 ${bytes} 字节\n`);
diff --git a/scripts/verify/test1-rpc.ts b/scripts/verify/test1-rpc.ts
new file mode 100644
index 000000000..cc0cb03a0
--- /dev/null
+++ b/scripts/verify/test1-rpc.ts
@@ -0,0 +1,170 @@
+/**
+ * 测试版固定数据用（只在 v0.1.0-test.1 的工作树里，不进产品）：像前端那样经后端的协议调用学习插件的方法上课。
+ * 随包课里有排序、表格和多空填空，走查的界面作答助手只会选择和填空，所以长一些的流程走这里。
+ * 标准答案取自课程文件，选项按交付事实的 seed 换成这次交付的不透明编号（与学习插件自己的 renderDelivery 相同）。
+ */
+import { readFile } from "node:fs/promises";
+import path from "node:path";
+import { pathToFileURL } from "node:url";
+
+import { RepaClient } from "@repa/base/client";
+
+import type { App } from "./app.js";
+import { REPO } from "./app.js";
+
+const INTERACTION = { supports: ["slot.choice", "slot.text", "slot.order", "slot.table", "slot.code", "block.markdown", "block.code", "markdown.math"] };
+/** 与 apps/web 的 interactionCapabilities 和 app.tsx 的服务声明相同。 */
+export const WEB_CAPABILITIES = { interaction: INTERACTION, services: ["python.run"] };
+/** 不声明 python.run：这条连接不提供页面里的 Python，菜单不给要运行代码的课，免得判分找不到运行器。 */
+export const NO_PYTHON = { interaction: INTERACTION, services: [] as string[] };
+export const PYTHON_COURSE = path.join(REPO, "packages/learning/courses/python");
+
+const dist = path.join(REPO, "packages/learning/dist");
+async function modules() {
+  const load = await import(pathToFileURL(path.join(dist, "format/load.js")).href) as typeof import("../../packages/learning/dist/format/load.js");
+  const diagnostics = await import(pathToFileURL(path.join(dist, "format/diagnostics.js")).href) as typeof import("../../packages/learning/dist/format/diagnostics.js");
+  const items = await import(pathToFileURL(path.join(dist, "check/items.js")).href) as typeof import("../../packages/learning/dist/check/items.js");
+  const delivery = await import(pathToFileURL(path.join(dist, "delivery.js")).href) as typeof import("../../packages/learning/dist/delivery.js");
+  return { load, diagnostics, items, delivery };
+}
+
+export type State = {
+  revision: number;
+  task: null | { taskId: string; kind: string; phase: { stage: string; deliveryId?: string; outcome?: string }; deliveries: { deliveryId: string; submissionId: string; item: { id: string; version: string; slots: { id: string }[] } }[] };
+  menu: null | { menuId: string; candidates: { id: string; kind: string; topicIds: string[] }[] };
+};
+/** 一道题怎样作答：按标准答案、故意答错、说“不会”。 */
+export type Plan = "correct" | "wrong" | "dontKnow";
+type QuestionEntry = { question: { id: string; slots: { id: string; type: string; key?: unknown; options?: { id: string }[] }[] }; topic: unknown; kpId: string };
+
+export class LearningRpc {
+  private constructor(private client: RepaClient, private opening: string, private space: string, private course: Map<string, QuestionEntry>) {}
+
+  static async connect(app: App, space: string, options: { course?: string; capabilities?: object } = {}): Promise<LearningRpc> {
+    if (!app.backend) throw new Error("后端没有在运行");
+    const client = await RepaClient.connect(app.backend.connection, { capabilities: options.capabilities ?? WEB_CAPABILITIES } as never);
+    const opening = client.handshake.baseline.space?.opening;
+    if (opening === undefined) throw new Error("后端现在没有打开的空间");
+    const { load, diagnostics, items } = await modules();
+    const report = new diagnostics.Report();
+    const loaded = await load.loadCourse(options.course ?? PYTHON_COURSE, report);
+    if (!loaded) throw new Error(`读不出课：${report.diagnostics.map((entry) => entry.message).join("；")}`);
+    const course = new Map<string, QuestionEntry>();
+    for (const { topic } of loaded.topics) {
+      for (const entry of items.topicQuestions(topic)) course.set(entry.question.id, { question: entry.question as never, topic, kpId: entry.kp.id });
+    }
+    return new LearningRpc(client, opening, space, course);
+  }
+
+  call<T = State>(method: string, input: unknown = {}): Promise<T> {
+    return this.client.call("plugin.call" as never, { pluginId: "learning", method, input, opening: this.opening } as never) as Promise<T>;
+  }
+
+  state(): Promise<State> {
+    return this.call("state.get");
+  }
+
+  /** 交付事实：题目 id 与 seed。只读文件。 */
+  private async delivered(seq: number): Promise<{ question: string; seed: number; task: number }> {
+    const facts = (await readFile(path.join(this.space, ".repa", "plugins", "learning", "records.jsonl"), "utf8")).split("\n").filter(Boolean).map((line) => JSON.parse(line) as { seq: number; type: string; question?: string; seed?: number; task?: number });
+    const fact = facts.find((entry) => entry.seq === seq && entry.type === "delivered");
+    if (!fact?.question || fact.seed === undefined || fact.task === undefined) throw new Error(`找不到交付事实 ${seq}`);
+    return { question: fact.question, seed: fact.seed, task: fact.task };
+  }
+
+  /** 当前待作答的那道题在课程里的 id。 */
+  async pendingQuestion(state?: State): Promise<string | undefined> {
+    const current = state ?? await this.state();
+    const deliveryId = current.task?.phase.stage === "awaiting_answer" ? current.task.phase.deliveryId : undefined;
+    return deliveryId === undefined ? undefined : (await this.delivered(Number(deliveryId.slice(1)))).question;
+  }
+
+  /** 交上当前这道题。 */
+  async submit(plan: Plan, state?: State): Promise<string> {
+    const current = state ?? await this.state();
+    const task = current.task;
+    const shown = task?.deliveries.find((entry) => entry.deliveryId === task.phase.deliveryId);
+    if (!task || !shown || task.phase.stage !== "awaiting_answer") throw new Error(`没有待作答的交付：${JSON.stringify(task?.phase)}`);
+    const { question } = await this.delivered(Number(shown.deliveryId.slice(1)));
+    const entry = this.course.get(question);
+    if (!entry) throw new Error(`课里没有 ${question}`);
+    const { seed } = await this.delivered(Number(shown.deliveryId.slice(1)));
+    const { items, delivery } = await modules();
+    const mode = task.kind === "lesson" ? "practice" : task.kind === "review" ? "review" : "quiz";
+    const { idMap } = await delivery.renderDelivery(entry.question as never, entry.topic as never, entry.kpId, mode, { deliveryId: shown.deliveryId, submissionId: shown.submissionId, repeated: false }, seed);
+    const reference = items.referenceResponse(entry.question as never, shown.item as never);
+    let answers: Record<string, unknown> = reference.answers;
+    // 要在页面里运行代码才能判的题，这条连接给不出 python.run，一律说“不会”：判分当场记为错，不用运行代码。
+    let effective: Plan = entry.question.slots.some((slot) => items.slotTests(slot as never).length > 0) ? "dontKnow" : plan;
+    if (effective === "wrong") {
+      // 选择题选一个不是答案的选项，填空写一个不在答案里的字；其他题型说“不会”。
+      const wrong: Record<string, unknown> = {};
+      for (const slot of entry.question.slots) {
+        const keys = (Array.isArray(slot.key) ? slot.key : [slot.key]).map(String);
+        if (slot.type === "choice") wrong[slot.id] = { type: "choice", selected: [slot.options?.find((option) => !keys.includes(option.id))?.id ?? ""] };
+        else if (slot.type === "text" && slot.key !== undefined) wrong[slot.id] = { type: "text", text: "错" };
+        else effective = "dontKnow";
+      }
+      answers = wrong;
+    }
+    const mapped = Object.fromEntries(Object.entries(answers).map(([slotId, answer]) => {
+      const slot = shown.item.slots.find((candidate) => candidate.id === slotId);
+      return [slotId, slot ? delivery.mapAnswer(answer as never, slot as never, idMap, true) : answer];
+    }));
+    const response = effective === "dontKnow" ? { item: reference.item, answers: {}, dontKnow: true } : { item: reference.item, answers: mapped };
+    const receipt = await this.call<{ status: string }>("submission.submit", { taskId: task.taskId, deliveryId: shown.deliveryId, submissionId: shown.submissionId, response });
+    if (receipt.status !== "recorded") throw new Error(`作答没有收下：${JSON.stringify(receipt)}`);
+    return question;
+  }
+
+  /** 从菜单开始一项候选：给 topic 时找这个 topic 的那一项，给 kind 时按类型找。 */
+  async start(options: { topic?: string; kind?: string }): Promise<State> {
+    const state = await this.state();
+    const candidate = state.menu?.candidates.find((entry) => (options.kind === undefined || entry.kind === options.kind) && (options.topic === undefined || entry.topicIds[0] === options.topic));
+    if (!state.menu || !candidate) throw new Error(`菜单里没有 ${JSON.stringify(options)}：${JSON.stringify(state.menu)}`);
+    return this.call("menu.select", { menuId: state.menu.menuId, candidateId: candidate.id });
+  }
+
+  /**
+   * 推进当前任务直到结束：plan 决定每道题怎样答（缺省按标准答案）；stopBefore 对某道题返回真时停在它的作答画面，不交。
+   * 交回答过的题和最后的状态。
+   */
+  async work(options: { plan?: (question: string, index: number) => Plan; stopBefore?: (question: string, index: number) => boolean } = {}): Promise<{ answered: string[]; state: State }> {
+    const answered: string[] = [];
+    for (let round = 0; round < 300; round++) {
+      const state = await this.state();
+      const task = state.task;
+      if (!task) throw new Error("没有当前任务");
+      const stage = task.phase.stage;
+      if (stage === "completed" || stage === "aborted") return { answered, state };
+      if (stage === "awaiting_answer") {
+        const question = await this.pendingQuestion(state);
+        if (question !== undefined && options.stopBefore?.(question, answered.length)) return { answered, state };
+        answered.push(await this.submit(options.plan?.(question ?? "", answered.length) ?? "correct", state));
+      } else if (stage === "judging") {
+        await new Promise((resolve) => setTimeout(resolve, 200));
+      } else if (stage === "preparing") {
+        await this.call("task.resume", { taskId: task.taskId, expectedStage: stage, expectedRevision: state.revision });
+      } else {
+        await this.call("task.advance", { taskId: task.taskId, expectedStage: stage, expectedRevision: state.revision });
+      }
+    }
+    throw new Error("300 次操作内没有做完");
+  }
+
+  async abort(): Promise<State> {
+    const state = await this.state();
+    const task = state.task;
+    if (!task) throw new Error("没有当前任务");
+    return this.call("task.abort", { taskId: task.taskId, expectedStage: task.phase.stage, expectedRevision: state.revision });
+  }
+
+  /** 学习记录现在有几行（事实条数）。只读文件。 */
+  async facts(): Promise<number> {
+    return (await readFile(path.join(this.space, ".repa", "plugins", "learning", "records.jsonl"), "utf8")).split("\n").filter(Boolean).length;
+  }
+
+  close(): Promise<void> {
+    return this.client.close();
+  }
+}
