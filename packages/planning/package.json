{
  "name": "@repa/planning",
  "version": "0.1.0",
  "description": "Repa 学习规划方法与时间约束检查",
  "type": "module",
  "files": ["dist", "skills", "README.md"],
  "exports": {
    "./package.json": "./package.json",
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./protocol": { "types": "./dist/schema.d.ts", "import": "./dist/schema.js" }
  },
  "pi": { "skills": ["./skills"] },
  "repa": {
    "manifestVersion": 1,
    "backend": { "entry": "./dist/index.js", "api": "^1.0.0" }
  },
  "engines": { "node": "^22.22.2 || ^24.15.0 || >=26.0.0" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "node --import tsx --test test/*.test.ts",
    "prepack": "npm run build"
  },
  "peerDependencies": { "repa": "^0.1.0" },
  "dependencies": { "@js-temporal/polyfill": "0.5.1", "typebox": "1.3.27" },
  "devDependencies": { "@types/node": "22.19.21", "tsx": "4.23.12", "typescript": "5.9.3" }
}
