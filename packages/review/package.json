{
  "name": "@repa/review",
  "version": "0.1.0",
  "description": "Repa 复习记录与 FSRS 调度能力",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    }
  },
  "repa": {
    "manifestVersion": 1,
    "backend": {
      "entry": "./dist/index.js",
      "api": "^1.0.0"
    },
    "snapshot": {
      "entry": "./dist/snapshot.js",
      "api": "^1.0.0"
    }
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "node --import tsx --test test/*.test.ts",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "repa": "^0.1.0"
  },
  "dependencies": {
    "ts-fsrs": "5.4.2",
    "typebox": "1.3.27"
  },
  "optionalDependencies": {
    "@open-spaced-repetition/binding": "0.5.0"
  },
  "devDependencies": {
    "@types/node": "22.19.21",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  }
}
