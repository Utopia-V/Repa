{
  "name": "@repa/desktop",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "build": "npm run build:app",
    "package:linux": "node scripts/package-linux.mjs",
    "verify:linux": "node scripts/verify-linux-package.mjs",
    "package:mac": "node scripts/package-mac.mjs",
    "verify:mac": "node scripts/verify-mac-package.mjs",
    "package:win": "node scripts/package-win.mjs",
    "verify:win": "node scripts/verify-win-package.mjs",
    "check": "tsc --noEmit",
    "dev": "electron-vite dev",
    "prebuild": "npm run build:packages --prefix ../..",
    "precheck": "npm run build:packages --prefix ../..",
    "predev": "npm run build:packages --prefix ../..",
    "pretest": "npm run build:packages --prefix ../..",
    "test": "vitest run",
    "build:app": "electron-vite build"
  },
  "dependencies": {
    "@repa/base": "0.1.0",
    "@repa/learning": "0.1.0",
    "@repa/python-runner": "0.1.0",
    "pyodide": "314.0.7"
  },
  "devDependencies": {
    "@types/node": "22.19.21",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "5.0.0"
  }
}
